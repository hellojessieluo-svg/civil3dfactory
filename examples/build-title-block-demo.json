          { "points": [[230, 10], [410, 10], [410, 50], [230, 50]], "closed": true, "layer": "C3DF-FRAME", "width": 0.5 }
        ],
        "lines": [
          { "x1": 230, "y1": 40, "x2": 410, "y2": 40, "layer": "C3DF-FRAME" },
          { "x1": 230, "y1": 30, "x2": 410, "y2": 30, "layer": "C3DF-FRAME" },
          { "x1": 230, "y1": 20, "x2": 380, "y2": 20, "layer": "C3DF-FRAME" },
          { "x1": 320, "y1": 10, "x2": 320, "y2": 30, "layer": "C3DF-FRAME" },
          { "x1": 380, "y1": 10, "x2": 380, "y2": 30, "layer": "C3DF-FRAME" }
        ],
        "texts": [
          { "x": 233, "y": 43.5, "text": "PROJECT", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 233, "y": 33.5, "text": "SHEET TITLE", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 233, "y": 23.5, "text": "DESIGNED", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 323, "y": 23.5, "text": "CHECKED", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 233, "y": 13.5, "text": "SCALE", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 323, "y": 13.5, "text": "DATE", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 383, "y": 24, "text": "SHEET", "height": 2.5, "layer": "C3DF-TEXT" },
          { "x": 28, "y": 281, "text": "NOTES", "height": 2.5, "layer": "C3DF-TEXT" }
        ]
      },
      "attributes": [
        { "tag": "PROJECT",     "prompt": "Project name",  "default": "PROJECT NAME",  "x": 258, "y": 45, "height": 3.5, "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "SHEET_TITLE", "prompt": "Sheet title",   "default": "SHEET TITLE",   "x": 258, "y": 35, "height": 3.5, "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "DESIGNED",    "prompt": "Designed by",   "default": "-",             "x": 258, "y": 25, "height": 3,   "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "CHECKED",     "prompt": "Checked by",    "default": "-",             "x": 348, "y": 25, "height": 3,   "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "SCALE",       "prompt": "Scale",         "default": "1:500",         "x": 258, "y": 15, "height": 3,   "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "DATE",        "prompt": "Date",          "default": "2026-01-01",    "x": 348, "y": 15, "height": 3,   "justify": "middle-left", "layer": "C3DF-TEXT" },
        { "tag": "SHEET_NO",    "prompt": "Sheet number",  "default": "01",            "x": 395, "y": 15, "height": 6,   "justify": "center",      "layer": "C3DF-TEXT" },
        { "tag": "NOTES",       "prompt": "Notes",         "default": "1. Demo sheet.", "x": 28, "y": 278, "height": 2.5, "mtext": true, "width": 170, "layer": "C3DF-TEXT" }
      ],
      "inserts": [
        { "x": 0,   "y": 0, "attributes": { "PROJECT": "Channel demo", "SHEET_TITLE": "Plan",     "SHEET_NO": "01", "SCALE": "1:500", "DATE": "2026-09-12", "DESIGNED": "civil3dfactory", "CHECKED": "-", "NOTES": "1. Demo sheet built by create_block_definition.\\P2. Edit these values with DWGAttributeEditor.exe --headless-export / --headless-update." } },
