    {
      "op": "create_block_definition",
      "name": "C3DF-DEMO-CONTENT",
      "layers": [ { "name": "C3DF-CONTENT", "color": 5 } ],
      "layer": "C3DF-CONTENT",
      "entities": {
        "polylines": [ { "points": [[40, 80], [120, 110], [220, 100], [330, 140], [390, 130]], "closed": false, "width": 0.5 } ],
        "circles": [ { "x": 200, "y": 180, "r": 40 } ],
        "lines": [ { "x1": 60, "y1": 200, "x2": 380, "y2": 200 }, { "x1": 60, "y1": 220, "x2": 380, "y2": 220 } ],
        "texts": [ { "x": 60, "y": 240, "text": "SAMPLE CONTENT - REPLACE WITH YOUR DRAWING", "height": 5 } ]
      },
      "inserts": [ { "x": 0, "y": 0 }, { "x": 450, "y": 0 }, { "x": 900, "y": 0 } ]
    },
    { "op": "save_dwg", "out": "{{C3DF_ROOT}}/examples/title-block-demo.dwg", "overwrite": true }
  ]
}
