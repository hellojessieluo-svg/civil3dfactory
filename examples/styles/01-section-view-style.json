{
  "_comment": "Edit the styles the drawing already has (no new styles): 5 m grid with 1 m minor lines and the station title on top for @C3DF-SimpleGrid, red ANSI31 hatch for the cut shape style, a thin grey ground line.",
  "ops": [
    {
      "op": "section_view_style",
      "name": "@C3DF-SimpleGrid",
      "grid": {
        "major_h": 5,
        "minor_h": 1,
        "major_v": 5,
        "minor_v": 1
      },
      "title": {
        "location": "Top",
        "text_height": 4
      }
    },
    {
      "op": "shape_style",
      "name": "@C3DF-CutFill",
      "hatch": {
        "type": "Pattern",
        "pattern": "ANSI31",
        "angle": 45,
        "scale": 0.5
      },
      "display": [
        {
          "component": "AreaFill",
          "view": "Section",
          "set": {
            "color": 1,
            "visible": true
          }
        },
        {
          "component": "Border",
          "view": "Section",
          "set": {
            "color": 1
          }
        }
      ]
    },
    {
      "op": "style_display",
      "cat": "SectionStyles",
      "name": "@C3DF-GroundLine",
      "view": "Section",
      "component": "Segments",
      "set": {
        "linetype": "Continuous",
        "lineweight": 18,
        "color": 8
      },
      "dry_run": false
    },
    {
      "op": "save_dwg",
      "out": "{{C3DF_ROOT}}/tmp/styles.dwg",
      "overwrite": true
    }
  ]
}
