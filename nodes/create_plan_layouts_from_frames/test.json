{
  "node": "create_plan_layouts_from_frames",
  "version": 1,
  "fixture": "examples/title-block-demo.dwg",
  "prerequisite": "horizontal plan frames with C3DF_PLAN_FRAME XData and an A3 title block",
  "args": {
    "block": "${title_block}",
    "from_dwg": "${title_block_library}",
    "paper": "A3",
    "scale": 5000,
    "frame_layer": "C3DF-PLAN-FRAME-NOPLOT",
    "layout_prefix": "PLAN-",
    "max_layouts": 3,
    "attributes": {
      "SHEET_TITLE": "Plan ({start_station} to {end_station})",
      "SHEET_NO": "PLAN-{n:00}",
      "SCALE": "1:5000",
      "PAGE": "{n}",
      "PAGES": "{total}"
    }
  },
  "assertions": [
    "data.count > 0",
    "data.count <= 3",
    "data.sheet_set == false",
    "data.view_rotation == 0",
    "data.layouts[*].result.viewport.locked == true"
  ],
  "status": "awaiting_real_dwg_regression"
}
