<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>CadBatchPlugin</AssemblyName>
    <RootNamespace>CadBatchPlugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD managed API (AcCoreMgd / AcDbMgd / AcMgd) from NuGet; runtime assets are
         excluded because accoreconsole supplies the real DLLs at load time. -->
    <PackageReference Include="Digi-Ants.AutoCAD.API.Core" Version="2025.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
